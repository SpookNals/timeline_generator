{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CV Timeline",
  "version": "0.1.0",
  "identifier": "nl.cvtimeline.desktop",
  "build": { "frontendDist": "./frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "CV Timeline", "width": 1320, "height": 860, "minWidth": 900, "minHeight": 650, "backgroundColor": "#17191d" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["assets/icon.ico", "assets/icon.png"] }
}
